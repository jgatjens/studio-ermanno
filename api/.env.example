APP_ENV=development
# Local release commands may select a separate ignored file using APP_ENV_FILE.
# Example: APP_ENV_FILE=.env.production python -m app.db.check
DATABASE_URL=
# Per-process pool budget; include overlapping deployments when sizing.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
# Production DATABASE_URL requires ?sslmode=require (or certificate verification).
FRONTEND_ORIGIN=http://localhost:5173
SEED_TIMEZONE=Europe/Rome
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Backend-owned business for public feedback and availability; use the actual business UUID.
PUBLIC_BUSINESS_ID=
